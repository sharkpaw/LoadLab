# For running locally: cp .env.example .env  (not used on Coolify; variables come from its panel)
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
PORT=8080
PUBLIC_URL=http://localhost:8080

# Values auto-generated on Coolify — set them manually when running locally
# openssl rand -hex 16
SERVICE_PASSWORD_POSTGRES=change-me
# openssl rand -hex 32
SERVICE_HEX_64_AUTH=change-me
# First admin password (at least 10 characters)
SERVICE_PASSWORD_ADMIN=change-me-min-10-chars
ADMIN_EMAIL=admin@example.com

# Optional
TZ=UTC
WORKER_REPLICAS=1
# Workers with Chromium for browser workflows (front-end metrics); 0 = off
BROWSER_WORKER_REPLICAS=0
MAX_BROWSER_VUS=5
MAX_VUS=5000
MAX_RATE=20000
MAX_DURATION_SEC=14400
# STARTING tests via MCP (off by default: drafts are started from the panel)
MCP_ALLOW_RUN=false
MCP_ALLOW_DEBUG=true
# OAuth sign-in for MCP clients (needs an HTTPS PUBLIC_URL, or localhost). API keys keep working either way.
MCP_OAUTH=true
# A static MCP key (preferably generate one under Settings in the panel)
MCP_TOKEN=

# Optional SMTP for "forgot password" mail. Without SMTP_HOST the reset link is printed to the loadlab log:
#   docker compose logs loadlab | grep "reset link"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LoadLab <no-reply@example.com>
